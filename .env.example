
# how to use
#   1. copy this file and name the copy .env
#   2. this 'env.example' file is just an example, so don't put real passwords/keys in here
#       this one is committed to GitHub so everyone has an example at start
#   3. these variables are just examples, will probably need most of them and will add more 
#      in the future

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

SESSION_SECRET=

# Minutes of inactivity before a session expires (default 30).
# Use a small value like 0.25 to demo the timeout.
SESSION_IDLE_MINUTES=

# Minutes before expiry that the browser warns, with a countdown (default 5).
# Capped at half the idle window, so a short demo window still shows it.
SESSION_WARNING_MINUTES=

# Where signed-in sessions are kept: the database by default, so a deployment
# does not sign everyone out. Set to 'memory' to keep them in the web server's
# memory instead (no sessions table needed, but a restart ends every session).
SESSION_STORE=

# Hours a session row is kept in the database (default 24). This is not the
# session's lifetime, which SESSION_IDLE_MINUTES decides; the row outlives it
# so an expired visitor can be told their session expired.
SESSION_ROW_HOURS=

# How often expired session rows are cleared out, in minutes (default 60).
SESSION_PRUNE_MINUTES=

# Hours a new user's setup link stays valid (default 48).
SETUP_LINK_HOURS=

# Where account email goes: 'console' (default) writes it to the server log,
# 'smtp' sends it for real using the settings below, 'silent' drops it.
MAIL_TRANSPORT=

# SMTP server for MAIL_TRANSPORT=smtp. In the deployed environment these are
# the SES SMTP endpoint and an SES SMTP credential -- which is not an AWS
# access key, it is generated separately in the SES console.
# Port 587 (the default) upgrades to TLS; 465 is TLS from the start.
# With any of these missing the app says which ones and writes mail to the log
# instead, so a reset link is never silently dropped.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=

# The From address. It must be verified in SES, or SES refuses the message.
MAIL_FROM=

# How many reset links one account can be sent in a row (default 3) and the
# window that is counted over, in minutes (default 15). Stops the forgot
# password form being used to fill somebody's inbox.
RESET_LINK_MAX_REQUESTS=
RESET_LINK_WINDOW_MINUTES=

# Public base URL used in password-reset links (default: the request's host).
APP_BASE_URL=

# Failed sign-ins before an account locks (default 5).
LOGIN_MAX_FAILURES=

# The longest a lock can last, in minutes (default 15). Also how far back
# failures are counted. Use a small value like 1 to demo the lockout.
LOGIN_LOCKOUT_MINUTES=

# The lock at the limit, in minutes (default 1). Each further failure doubles
# it, up to LOGIN_LOCKOUT_MINUTES.
LOGIN_FIRST_WAIT_MINUTES=


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=