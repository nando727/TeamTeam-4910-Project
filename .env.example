
# how to use
#   1. copy this file and name the copy .env
#   2. this 'env.example' file is just an example, so don't put real passwords/keys in here
#       this one is committed to GitHub so everyone has an example at start
#   3. these variables are just examples, will probably need most of them and will add more 
#      in the future

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

SESSION_SECRET=

# Minutes of inactivity before a session expires (default 30).
# Use a small value like 0.25 to demo the timeout.
SESSION_IDLE_MINUTES=


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=