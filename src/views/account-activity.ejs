<%- include('partials/head', { title: 'Account activity' }) %>
  <section class="card">
    <div class="page-header">
      <span class="eyebrow">Your account</span>
      <h1>Account activity</h1>
      <p class="lede">Recent sign-ins to your account and the changes an administrator made to it, newest first.</p>
    </div>

    <h2 class="section-title">Recent sign-ins</h2>
    <% if (!signIns.length) { %>
      <div class="info" role="status"><p>No sign-ins are recorded for your account yet.</p></div>
    <% } else { %>
      <p class="muted small">Your last <%= signIns.length %> sign-in attempt<%= signIns.length === 1 ? '' : 's' %>. Don't recognize one? <a href="/profile/password">Change your password</a>, then sign out of all sessions from your profile.</p>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">When (UTC)</th>
              <th scope="col">Result</th>
              <th scope="col">From address</th>
            </tr>
          </thead>
          <tbody>
            <% signIns.forEach(signIn => { %>
              <tr>
                <td class="nowrap"><%= formatStamp(signIn.when) %></td>
                <td><span class="status-badge <%= signIn.ok ? 'status-active' : 'status-revoked' %>"><%= signIn.ok ? 'Signed in' : 'Failed' %></span></td>
                <td><%= signIn.from || 'Unknown' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <h2 class="section-title">Changes by an administrator</h2>
    <p class="muted small">Password resets, role and status changes, sponsorships, points, and unlocks.</p>
    <% if (!changes.length) { %>
      <div class="info" role="status"><p>An administrator has not changed anything on your account.</p></div>
    <% } else { %>
      <p class="muted small"><%= limited ? `The ${limit} most recent of ${total.toLocaleString('en-US')} changes.` : `${total} change${total === 1 ? '' : 's'}.` %></p>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">When (UTC)</th>
              <th scope="col">What changed</th>
              <th scope="col">Detail</th>
            </tr>
          </thead>
          <tbody>
            <% changes.forEach(change => { %>
              <tr>
                <td class="nowrap"><%= formatStamp(change.when) %></td>
                <td class="cell-strong"><%= change.what %></td>
                <td><%= change.detail || '—' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
    <p style="margin-top: 20px;"><a href="/profile">Back to your profile</a></p>
  </section>
<%- include('partials/foot') %>
