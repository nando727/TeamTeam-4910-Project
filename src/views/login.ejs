<%- include('partials/head', { title: 'Log In' }) %>
  <div class="page--center">
    <section class="card card--narrow login-card">
      <%- include('partials/logo') %>
      <h1>Good Driver Incentive Program</h1>
      <p class="lede">Sign in to continue</p>
      <% if (locals.notice) { %>
        <p class="success" role="status"><%= locals.notice %></p>
      <% } %>
      <%# Story 22215: a locked sign-in explains the ways back in, so the
          reset can be a link the visitor can actually follow. %>
      <% if (locals.lockout) { %>
        <div class="error" role="alert">
          <p><%= lockout.summary %></p>
          <ul class="recovery">
            <li><%= lockout.waitText %> <span class="recovery__aside"><%= lockout.retryWarning %></span></li>
            <li><a href="<%= lockout.resetPath %>"><%= lockout.resetText %></a></li>
            <li><%= lockout.adminText %></li>
          </ul>
        </div>
      <% } else if (error) { %>
        <p class="error" role="alert"><%= error %></p>
      <% } %>
      <form method="POST" action="/login">
        <label for="username">Username</label>
        <input id="username" name="username" type="text" autocomplete="username" required>

        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required
               data-toggle-visibility>

        <button type="submit">Log In</button>
      </form>
      <p class="hint" style="margin-top: 16px; text-align: center;"><a href="/forgot-password">Forgot your password?</a></p>
    </section>
  </div>
  <%# Story 22217: adds a Show/Hide button to the password field. The page
     works without it; the script only enhances the field. %>
  <script src="/password-toggle.js" defer></script>
<%- include('partials/foot') %>
