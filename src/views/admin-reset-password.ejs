<%- include('partials/head', { title: 'Reset password' }) %>
  <section class="card card--form">
    <div class="page-header">
      <span class="eyebrow">Administration</span>
      <h1>Reset password</h1>
      <p class="lede">Set a new password for this user. Share it with them privately and ask them to change it after signing in.</p>
    </div>
    <dl class="details">
      <dt>Username</dt><dd><%= user.username %></dd>
      <dt>Role</dt><dd><span class="role-chip"><%= user.role %></span></dd>
      <dt>Status</dt><dd><span class="status-badge status-<%= user.status %>"><%= user.status %></span></dd>
      <dt>Failed sign-ins, last 24 hours</dt><dd><%= failedLogins %></dd>
    </dl>
    <% if (user.status !== 'active') { %>
      <p class="info" role="status">This account is <%= user.status %>. A new password will not let them sign in until the status is set back to active.</p>
    <% } %>
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <form method="POST" action="/admin/manage-users/<%= user.id %>/password">
      <input type="hidden" name="token" value="<%= token %>">
      <input type="hidden" name="from" value="<%= from %>">
      <label for="newPassword">New password</label>
      <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" required minlength="8" maxlength="<%= maxLength %>">
      <%- include('partials/password-rules', { inputId: 'newPassword', rules }) %>

      <label for="confirmPassword">Confirm new password</label>
      <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required data-confirm-for="newPassword">

      <div class="button-row">
        <button type="submit">Reset password</button>
        <a class="button-link" href="<%= returnTo %>">Cancel</a>
      </div>
    </form>
  </section>
  <script src="/password-rules.js" defer></script>
<%- include('partials/foot') %>
