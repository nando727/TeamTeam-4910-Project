<%- include('partials/head', { title: 'Forgot password' }) %>
  <div class="page--center">
    <section class="card card--narrow login-card">
      <%- include('partials/logo') %>
      <h1>Forgot your password?</h1>
      <% if (sent) { %>
        <p class="lede">Check for your reset link</p>
        <p class="success" role="status">If an account with that username exists and is active, a password reset link has been generated. It works once and expires in <%= expiryMinutes %> minutes.</p>
        <p class="hint">No email service is connected yet, so the link is printed in the server console. Ask an administrator to pass it to you.</p>
        <p style="margin-top: 20px;"><a class="button-link" href="/login">Back to sign in</a></p>
      <% } else { %>
        <p class="lede">Enter your username and we will generate a one-time reset link.</p>
        <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
        <form method="POST" action="/forgot-password">
          <label for="username">Username</label>
          <input id="username" name="username" type="text" autocomplete="username" maxlength="64" required value="<%= username %>">
          <button type="submit">Generate reset link</button>
        </form>
        <p class="hint" style="margin-top: 16px;"><a href="/login">Back to sign in</a></p>
      <% } %>
    </section>
  </div>
<%- include('partials/foot') %>
