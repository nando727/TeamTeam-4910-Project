<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home – Good Driver Incentive Program</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="card">
    <h1>Welcome, <%= user.username %></h1>
    <p>You are logged in as a <strong><%= user.role %></strong>.</p>
    <p><a href="/profile">View your profile</a> · <a href="/about">About this app</a></p>
    <% if (user.role === 'driver') { %>
      <p><a href="/sponsors">Apply to join a sponsor</a></p>
    <% } %>
    <% if (user.role === 'admin') { %>
      <p><a href="/admin/create-user">Create a user</a> · <a href="/admin/create-sponsor">Create a sponsor</a></p>
    <% } %>
    <p><em>Role-specific homepages arrive with story 22200.</em></p>
  </main>
</body>
</html>
