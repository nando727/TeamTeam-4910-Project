<%- include('partials/head', { title: 'Create sponsor' }) %>
  <section class="card card--form">
    <div class="page-header">
      <span class="eyebrow">Administration</span>
      <h1>Create sponsor</h1>
      <p class="lede">Register a sponsor organization. All fields are required.</p>
    </div>
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <% if (created) { %>
      <div class="success" role="status">
        <p><strong>Sponsor created successfully.</strong></p>
        <dl class="details">
          <dt>Organization name</dt><dd><%= created.name %></dd>
          <dt>Contact email</dt><dd><%= created.contactEmail %></dd>
          <dt>Contact phone</dt><dd><%= created.contactPhone %></dd>
          <dt>Address</dt><dd><%= created.address %></dd>
        </dl>
      </div>
    <% } %>
    <form method="POST" action="/admin/create-sponsor">
      <input type="hidden" name="token" value="<%= token %>">
      <label for="name">Organization name</label>
      <input id="name" name="name" type="text" autocomplete="organization" maxlength="255" required value="<%= values.name %>">

      <label for="contactEmail">Contact email</label>
      <input id="contactEmail" name="contactEmail" type="email" autocomplete="off" maxlength="255" required value="<%= values.contactEmail %>">

      <label for="contactPhone">Contact phone</label>
      <input id="contactPhone" name="contactPhone" type="tel" autocomplete="off" maxlength="32" required value="<%= values.contactPhone %>">

      <label for="address">Address</label>
      <input id="address" name="address" type="text" autocomplete="off" maxlength="255" required value="<%= values.address %>">

      <button type="submit">Create sponsor</button>
    </form>
  </section>
<%- include('partials/foot') %>
