<%# Live checklist under a password field. `inputId` is the field to watch;
    `rules` comes from PUBLIC_RULES in src/auth/password-policy.js. The page
    must also load /password-rules.js. Without JavaScript this is a plain list. %>
<ul class="rules" data-password-rules data-for="<%= inputId %>">
  <% rules.forEach(rule => { %>
    <li data-rule="<%= rule.id %>" data-pattern="<%= rule.pattern %>"><span class="rules__mark" aria-hidden="true"></span><%= rule.label %></li>
  <% }); %>
</ul>
