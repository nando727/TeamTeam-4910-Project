<%- include('../partials/head', { title: 'Admin Home' }) %>
  <section class="hero">
    <%- include('../partials/shield') %>
    <div>
      <h1>Welcome, <%= user.username %></h1>
      <p>You are signed in as an admin.</p>
    </div>
  </section>

  <h2 class="section-title">Administration</h2>
  <div class="actions">
    <a class="action" href="/admin/create-user">
      <span class="action__icon" aria-hidden="true">+</span>
      <span class="action__title">Create a user</span>
      <span class="action__text">Add a driver, sponsor, or admin account.</span>
    </a>
    <a class="action" href="/admin/manage-users">
      <span class="action__icon" aria-hidden="true">≡</span>
      <span class="action__title">Manage users</span>
      <span class="action__text">Review accounts and change their status.</span>
    </a>
    <a class="action" href="/admin/create-sponsor">
      <span class="action__icon" aria-hidden="true">+</span>
      <span class="action__title">Create a sponsor</span>
      <span class="action__text">Register a new sponsor organization.</span>
    </a>
    <a class="action" href="/admin/sponsor-status">
      <span class="action__icon" aria-hidden="true">≡</span>
      <span class="action__title">Sponsor status</span>
      <span class="action__text">See every sponsor and whether it is active.</span>
    </a>
  </div>

  <h2 class="section-title">Your account</h2>
  <div class="actions">
    <a class="action" href="/profile">
      <span class="action__icon" aria-hidden="true">@</span>
      <span class="action__title">View your profile</span>
      <span class="action__text">See and update your name and email.</span>
    </a>
    <a class="action" href="/about">
      <span class="action__icon" aria-hidden="true">i</span>
      <span class="action__title">About this app</span>
      <span class="action__text">Team, version, and release information.</span>
    </a>
  </div>
<%- include('../partials/foot') %>
