<%- include('partials/head', { title: 'Change password' }) %>
  <section class="card card--form">
    <div class="page-header">
      <span class="eyebrow">Your account</span>
      <h1>Change password</h1>
      <p class="lede">Enter your current password, then choose a new one that meets every rule below.</p>
    </div>
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <form method="POST" action="/profile/password">
      <input type="hidden" name="token" value="<%= token %>">
      <label for="currentPassword">Current password</label>
      <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required>

      <label for="newPassword">New password</label>
      <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" required minlength="8" maxlength="<%= maxLength %>">
      <%- include('partials/password-rules', { inputId: 'newPassword', rules }) %>

      <label for="confirmPassword">Confirm new password</label>
      <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required data-confirm-for="newPassword">

      <div class="button-row">
        <button type="submit">Change password</button>
        <a class="button-link" href="/profile">Cancel</a>
      </div>
    </form>
  </section>
  <script src="/password-rules.js" defer></script>
<%- include('partials/foot') %>
