<%- include('../partials/head', { title: 'Sponsor Home' }) %>
  <section class="hero">
    <%- include('../partials/shield') %>
    <div>
      <h1>Welcome, <%= user.username %></h1>
      <p>You are signed in as a sponsor user.</p>
    </div>
  </section>

  <h2 class="section-title">Your account</h2>
  <div class="actions">
    <a class="action" href="/profile">
      <span class="action__icon" aria-hidden="true">@</span>
      <span class="action__title">View your profile</span>
      <span class="action__text">See and update your name and email.</span>
    </a>
    <a class="action" href="/about">
      <span class="action__icon" aria-hidden="true">i</span>
      <span class="action__title">About this app</span>
      <span class="action__text">Team, version, and release information.</span>
    </a>
  </div>

  <h2 class="section-title">Driver Applications</h2>
  <table class="table">
    <thead>
      <tr>
        <th>Applicant</th>
        <th>Contact</th>
        <th>Reason</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% applications.forEach(app => { %>
        <tr>
          <td><%= app.full_name %></td>
          <td><%= app.contact_email %></td>
          <td><%= app.reason %></td>
          <td><%= app.status %></td>
          <td>
            <% if (app.status === 'pending') { %>
              <form method="POST" action="/applications/<%= app.id %>/approve" class="inline-form">
                <input type="hidden" name="token" value="<%= formToken %>">
                <button type="submit">Approve</button>
              </form>
              <form method="POST" action="/applications/<%= app.id %>/reject" class="inline-form">
                <input type="hidden" name="token" value="<%= formToken %>">
                <input type="text" name="rejectionReason" placeholder="Reason" required>
                <button type="submit">Reject</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (applications.length === 0) { %>
        <tr><td colspan="5">No applications yet.</td></tr>
      <% } %>
    </tbody>
  </table>
<%- include('../partials/foot') %>
