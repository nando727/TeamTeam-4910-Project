<%- include('partials/head', { title: 'Join a sponsor' }) %>
  <section class="card card--form">
    <div class="page-header">
      <span class="eyebrow">Sponsors</span>
      <h1>Join a sponsor</h1>
      <p class="lede">Select a sponsor to start your application for its incentive program.</p>
    </div>
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <% if (success) { %><p class="success" role="status"><%= success %></p><% } %>
    <% if (sponsors.length === 0) { %>
      <p class="info" role="status">No sponsors are available yet. Please check back later.</p>
    <% } %>
    <div class="sponsor-list">
      <% sponsors.forEach(sponsor => { %>
        <section class="sponsor">
          <h2><%= sponsor.name %></h2>
          <% if (sponsor.application_id) { %>
            <span class="done">Application submitted</span>
          <% } else { %>
            <a class="button-link button--small" href="/sponsors/<%= sponsor.id %>/apply">Select <%= sponsor.name %></a>
          <% } %>
        </section>
      <% }); %>
    </div>
  </section>
<%- include('partials/foot') %>
