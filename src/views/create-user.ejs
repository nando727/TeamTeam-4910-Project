<%- include('partials/head', { title: 'Create user' }) %>
  <section class="card card--form">
    <div class="page-header">
      <span class="eyebrow">Administration</span>
      <h1>Create user</h1>
      <p class="lede">Leave the password blank to send the new user a setup link so they choose their own.</p>
    </div>
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <% if (created) { %>
      <div class="success" role="status">
        <p><strong>User created successfully.</strong></p>
        <dl class="details">
          <dt>Name</dt><dd><%= created.name %></dd>
          <dt>Email</dt><dd><%= created.email %></dd>
          <dt>Username</dt><dd><%= created.username %></dd>
          <dt>Role</dt><dd><%= created.role %></dd>
        </dl>
        <% if (locals.setupLink) { %>
          <p>Send this setup link to <%= created.name %> so they can choose a password.
            It works once, and a copy has been emailed to <%= created.email %>.</p>
          <p><input class="setup-link" type="text" readonly value="<%= setupLink %>"
                    aria-label="Setup link" onfocus="this.select()"></p>
        <% } else { %>
          <p>You set this user's password. They can sign in with it now.</p>
        <% } %>
      </div>
    <% } %>
    <form method="POST" action="/admin/create-user">
      <input type="hidden" name="token" value="<%= token %>">
      <label for="name">Name</label>
      <input id="name" name="name" type="text" autocomplete="off" maxlength="255" required value="<%= values.name %>">

      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="off" maxlength="255" required value="<%= values.email %>">

      <label for="username">Username</label>
      <input id="username" name="username" type="text" autocomplete="off" maxlength="64" required value="<%= values.username %>">

      <label for="password">Password <span class="muted">(optional)</span></label>
      <input id="password" name="password" type="password" autocomplete="new-password" minlength="8">
      <p class="hint">Leave blank to email a setup link instead. If you set one, use at least 8 characters.</p>

      <label for="role">Role</label>
      <select id="role" name="role" required>
        <option value="">Select a role</option>
        <% roles.forEach(role => { %>
          <option value="<%= role %>" <%= values.role === role ? 'selected' : '' %>><%= role %></option>
        <% }); %>
      </select>

      <button type="submit">Create user</button>
    </form>
  </section>
<%- include('partials/foot') %>
