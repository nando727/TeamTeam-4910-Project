<%- include('../partials/head', { title: 'My orders' }) %>
  <section class="card">
    <div class="page-header">
      <span class="eyebrow">Rewards</span>
      <h1>My orders</h1>
      <p class="lede">Everything you have bought with your points, newest first. Filter by sponsor or date, then download the same view as a CSV.</p>
      <dl class="report-summary" aria-label="Orders shown">
        <% summary.forEach(item => { %>
          <div class="report-summary__item"><dt><%= item.label %></dt><dd><%= item.value %></dd></div>
        <% }); %>
      </dl>
    </div>

    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <% if (locals.notice) { %><p class="<%= notice.kind %>" role="status"><%= notice.text %></p><% } %>

    <form class="filters" method="GET" action="/driver/orders" data-report-form>
      <input type="hidden" name="sort" value="<%= filters.sort %>">
      <input type="hidden" name="dir" value="<%= filters.dir %>">
      <div class="filters__field">
        <label for="sponsor">Sponsor</label>
        <select id="sponsor" name="sponsor">
          <option value="all">All sponsors</option>
          <% sponsors.forEach(sponsor => { %>
            <option value="<%= sponsor.id %>" <%= filters.sponsorId === sponsor.id ? 'selected' : '' %>><%= sponsor.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="filters__field">
        <label for="from">From</label>
        <input id="from" name="from" type="date" value="<%= filters.from || '' %>" max="<%= today %>">
      </div>
      <div class="filters__field">
        <label for="to">To</label>
        <input id="to" name="to" type="date" value="<%= filters.to || '' %>" max="<%= today %>">
      </div>
      <div class="filters__actions">
        <button type="submit">Apply</button>
        <a class="button-link" href="/driver/orders" data-busy="Resetting…">Clear</a>
      </div>
    </form>
    <p class="quick-ranges">
      <span class="muted small">Quick ranges:</span>
      <% quickRanges.forEach(range => { %>
        <a class="chip<%= range.active ? ' is-active' : '' %>" href="<%= range.href %>"<%- range.active ? ' aria-current="true"' : '' %> data-busy="Loading orders…"><%= range.label %></a>
      <% }); %>
    </p>

    <p class="report-status" id="report-status" role="status" aria-live="polite" hidden>
      <span class="spinner" aria-hidden="true"></span> <span class="report-status__text">Loading orders…</span>
    </p>

    <div class="report-bar">
      <span class="muted small">
        <% if (total === 0) { %>0 items<%= rangeLabel %><% } else { %>Showing <%= pageStart %> to <%= pageEnd %> of <%= total.toLocaleString('en-US') %> item<%= total === 1 ? '' : 's' %><%= rangeLabel %><% } %>
      </span>
      <a class="button-link button--small" href="<%= csvHref %>" data-busy="Preparing the CSV download…" data-busy-reset="4000">Download CSV</a>
    </div>

    <% if (grand.sales === 0 && !error) { %>
      <div class="info" role="status">
        <p><strong><%= emptyMessage.title %></strong></p>
        <p><%= emptyMessage.detail %> Widen the date range, <a href="/driver/orders">clear the filters</a>, or <a href="/driver/catalog">browse the catalog</a>.</p>
      </div>
    <% } %>

    <% if (rows.length > 0) { %>
      <div class="table-wrap">
        <table class="table table--sortable">
          <% const headers = [['date', 'Date (UTC)', ''], ['item', 'Item', ''], ['sponsor', 'Sponsor', ''], ['amount', 'Value', 'num'], ['points', 'Points spent', 'num']]; %>
          <thead>
            <tr>
              <% headers.forEach(([key, label, cls]) => { const link = sortLinks[key]; %>
                <th scope="col" class="<%= cls %>" <%- link.active ? `aria-sort="${link.dir === 'asc' ? 'ascending' : 'descending'}"` : '' %>>
                  <a class="sort-link<%= link.active ? ' is-active' : '' %>" href="<%= link.href %>" data-busy="Sorting…"><%= label %><span class="sort-arrow" aria-hidden="true"><%= link.active ? (link.dir === 'asc' ? '▲' : '▼') : '↕' %></span></a>
                </th>
              <% }); %>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(row => { %>
              <tr>
                <td class="nowrap"><%= formatStamp(row.purchasedAt) %></td>
                <td class="cell-strong"><%= row.item %></td>
                <td><%= row.sponsorName %></td>
                <td class="num"><%= dollars(row.amountCents) %></td>
                <td class="num"><%= Number(row.points).toLocaleString('en-US') %></td>
              </tr>
            <% }); %>
          </tbody>
          <tfoot>
            <tr>
              <th scope="row" colspan="3">Total for these filters, <%= grand.sales.toLocaleString('en-US') %> item<%= grand.sales === 1 ? '' : 's' %></th>
              <td class="num"><%= dollars(grand.totalCents) %></td>
              <td class="num cell-strong"><%= grand.points.toLocaleString('en-US') %></td>
            </tr>
          </tfoot>
        </table>
      </div>
      <% if (pageCount > 1) { %>
        <nav class="pager" aria-label="Order pages">
          <% if (prevHref) { %><a class="button-link button--small" href="<%= prevHref %>" data-busy="Loading page <%= page - 1 %>…">&larr; Previous</a><% } else { %><span class="button-link button--small is-disabled" aria-disabled="true">&larr; Previous</span><% } %>
          <span class="pager__status">Page <%= page %> of <%= pageCount %></span>
          <% if (nextHref) { %><a class="button-link button--small" href="<%= nextHref %>" data-busy="Loading page <%= page + 1 %>…">Next &rarr;</a><% } else { %><span class="button-link button--small is-disabled" aria-disabled="true">Next &rarr;</span><% } %>
        </nav>
      <% } %>
    <% } %>
  </section>
  <script src="/report.js" defer></script>
<%- include('../partials/foot') %>
