<%- include('../partials/head', { title: 'Driver Home' }) %>
  <section class="dash">
    <%- include('../partials/logo') %>
    <div class="dash__text">
      <h1>Welcome, <%= user.username %></h1>
      <p>You are signed in as a driver. <span class="dash__chip">driver</span></p>
    </div>
    <dl class="dash__stats">
      <div class="dash__stat"><dt>In your cart</dt><dd><%= locals.cartCount || 0 %></dd></div>
    </dl>
  </section>

  <h2 class="section-title">Your points</h2>
  <div class="actions actions--2">
    <a class="action" href="/driver/programs">
      <span class="action__icon"><%- include('../partials/icon', { name: 'chart' }) %></span>
      <span class="action__title">My sponsor and points</span>
      <span class="action__text">Your current balance with each sponsor program you belong to.</span>
    </a>
    <a class="action" href="/driver/points/history">
      <span class="action__icon"><%- include('../partials/icon', { name: 'receipt' }) %></span>
      <span class="action__title">My point history</span>
      <span class="action__text">Every award and deduction, newest first, with the reason given.</span>
    </a>
    <a class="action" href="/my-rules">
      <span class="action__icon"><%- include('../partials/icon', { name: 'building' }) %></span>
      <span class="action__title">My rule sets</span>
      <span class="action__text">All of the rules from the sponsors you belong to.</span>
    </a>
  </div>

  <h2 class="section-title">Rewards</h2>
  <div class="actions actions--3">
    <a class="action" href="/driver/catalog">
      <span class="action__icon"><%- include('../partials/icon', { name: 'cart' }) %></span>
      <span class="action__title">Product catalog</span>
      <span class="action__text">Browse what your sponsors offer and add items to your cart.</span>
    </a>
    <a class="action" href="/driver/cart">
      <span class="action__icon"><%- include('../partials/icon', { name: 'cart' }) %></span>
      <span class="action__title">Your cart<% if (locals.cartCount) { %> (<%= cartCount %>)<% } %></span>
      <span class="action__text">Review the items you picked and check out with your points.</span>
    </a>
    <a class="action" href="/driver/orders">
      <span class="action__icon"><%- include('../partials/icon', { name: 'receipt' }) %></span>
      <span class="action__title">My orders</span>
      <span class="action__text">Everything you have bought, with the date, sponsor, and points spent.</span>
    </a>
  </div>

  <h2 class="section-title">Sponsors</h2>
  <div class="actions actions--2">
    <a class="action" href="/sponsors">
      <span class="action__icon"><%- include('../partials/icon', { name: 'clipboard-check' }) %></span>
      <span class="action__title">View application status</span>
      <span class="action__text">See sponsor decisions and reasons for rejected applications.</span>
    </a>
    <a class="action" href="/sponsors">
      <span class="action__icon"><%- include('../partials/icon', { name: 'road' }) %></span>
      <span class="action__title">Apply to join a sponsor</span>
      <span class="action__text">Choose a sponsor and submit your application.</span>
    </a>
  </div>

  <h2 class="section-title">Your account</h2>
  <div class="actions actions--3">
    <a class="action" href="/profile">
      <span class="action__icon"><%- include('../partials/icon', { name: 'user-circle' }) %></span>
      <span class="action__title">View your profile</span>
      <span class="action__text">See and update your name and email.</span>
    </a>
    <a class="action" href="/profile/password">
      <span class="action__icon"><%- include('../partials/icon', { name: 'key' }) %></span>
      <span class="action__title">Change your password</span>
      <span class="action__text">Choose a new password that meets the complexity rules.</span>
    </a>
    <a class="action" href="/points/settings">
      <span class="action__icon"><%- include('../partials/icon', { name: 'info' }) %></span>
      <span class="action__title">Alert settings</span>
      <span class="action__text">Choose whether point changes are announced to you.</span>
    </a>
  </div>
<%- include('../partials/foot') %>
