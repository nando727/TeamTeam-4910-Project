<%- include('partials/head', { title: 'Review application' }) %>
  <section class="card card--form">
    <div class="page-header">
      <span class="eyebrow">Sponsor application</span>
      <h1>Review your application</h1>
      <p class="lede">Check your information before submitting.</p>
    </div>
    <dl class="details">
      <dt>Sponsor</dt><dd><%= sponsor.name %></dd>
      <dt>Full name</dt><dd><%= draft.fullName %></dd>
      <dt>Contact email</dt><dd><%= draft.contactEmail %></dd>
      <dt>Reason for applying</dt><dd><%= draft.reason %></dd>
    </dl>
    <form action="/sponsors/<%= sponsor.id %>/apply" method="post">
      <input type="hidden" name="token" value="<%= token %>">
      <input type="hidden" name="reviewId" value="<%= draft.reviewId %>">
      <div class="button-row">
        <button type="submit">Submit application</button>
        <a class="button-link" href="/sponsors/<%= sponsor.id %>/apply">Edit application</a>
      </div>
    </form>
  </section>
<%- include('partials/foot') %>
