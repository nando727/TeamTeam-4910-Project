<%- include('partials/head', { title: 'About' }) %>
  <section class="card card--form">
    <div class="page-header">
      <span class="eyebrow">Good Driver Incentive Program</span>
      <h1>About this app</h1>
      <p class="lede">Team, version, and release details for this build.</p>
    </div>
    <% if (!about) { %>
      <p class="error" role="alert">About information has not been added yet.</p>
    <% } else { %>
      <dl class="details">
        <dt>Team name</dt><dd><%= about.team_name %></dd>
        <dt>App version</dt><dd><%= about.app_version %></dd>
        <dt>Release date</dt><dd><%= releaseDate %></dd>
        <dt>Description</dt><dd><%= about.description %></dd>
      </dl>
    <% } %>
    <p style="margin-top: 20px;">
      <% if (user) { %><a class="button-link" href="/">Back to home</a><% } else { %><a class="button-link" href="/login">Log in</a><% } %>
    </p>
  </section>
<%- include('partials/foot') %>
