<%- include('partials/head', { title: 'Sponsor application' }) %>
  <section class="card card--form">
    <a class="back" href="/sponsors">Select a different sponsor</a>
    <div class="page-header">
      <span class="eyebrow">Sponsor application</span>
      <h1>Apply to <%= sponsor.name %></h1>
      <p class="lede">All fields are required. You can review your information before submitting.</p>
    </div>
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <form action="/sponsors/<%= sponsor.id %>/review" method="post">
      <input type="hidden" name="token" value="<%= token %>">
      <label for="fullName">Full name</label>
      <input id="fullName" name="fullName" autocomplete="name" maxlength="128" required value="<%= values.fullName %>">
      <label for="contactEmail">Contact email</label>
      <input id="contactEmail" name="contactEmail" type="email" autocomplete="email" maxlength="254" required value="<%= values.contactEmail %>">
      <label for="reason">Reason for applying</label>
      <textarea id="reason" name="reason" rows="6" maxlength="2000" required><%= values.reason %></textarea>
      <button type="submit">Review application</button>
    </form>
  </section>
<%- include('partials/foot') %>
