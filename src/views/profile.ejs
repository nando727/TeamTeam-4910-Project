<%- include('partials/head', { title: editing ? 'Edit profile' : 'Profile' }) %>
  <section class="card card--form">
    <div class="page-header">
      <span class="eyebrow">Your account</span>
      <h1><%= editing ? 'Edit profile' : 'Profile' %></h1>
      <p class="lede"><%= editing ? 'Update the name and email on your account.' : 'Your account details as stored in the program.' %></p>
    </div>
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <% if (success) { %><p class="success" role="status"><%= success %></p><% } %>
    <% if (editing) { %>
      <form method="POST" action="/profile">
        <input type="hidden" name="token" value="<%= token %>">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" maxlength="255" required value="<%= values.name %>">

        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" maxlength="255" required value="<%= values.email %>">

        <div class="button-row">
          <button type="submit">Save</button>
          <a class="button-link" href="/profile">Cancel</a>
        </div>
      </form>
    <% } else { %>
      <dl class="details">
        <dt>Name</dt><dd><%= profile.name || '—' %></dd>
        <dt>Email</dt><dd><%= profile.email || '—' %></dd>
        <dt>Username</dt><dd><%= profile.username %></dd>
        <dt>Role</dt><dd><span class="role-chip"><%= profile.role %></span></dd>
      </dl>
      <div class="button-row" style="margin-top: 20px;">
        <a class="button-link" href="/profile/edit">Edit profile</a>
        <a class="button-link" href="/profile/password">Change password</a>
      </div>
    <% } %>
  </section>

  <%# Backlog AA-13: end every session for this account, on every device. %>
  <% if (!editing) { %>
    <section class="card card--form">
      <h2>Signed in somewhere else?</h2>
      <p>Signing out of all sessions ends your session everywhere &mdash; other
        browsers, other devices, and this one. Use it if you signed in on a
        shared computer, or if you think someone else has access to your account.</p>
      <form method="POST" action="/profile/sign-out-everywhere">
        <input type="hidden" name="token" value="<%= token %>">
        <div class="button-row" style="margin-top: 16px;">
          <button type="submit" class="button--danger">Sign out of all sessions</button>
        </div>
      </form>
    </section>
  <% } %>
<%- include('partials/foot') %>
